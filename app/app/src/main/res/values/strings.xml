  <string name="onboarding_title">Welcome to DuoBackup</string>
  <string name="onboarding_intro">DuoBackup copies the files in your phone\'s shared storage to your own Google Drive and to a private Telegram channel. Nothing is sent anywhere else.</string>
  <string name="onboarding_storage_title">Access to your files</string>
  <string name="onboarding_storage_text">To back up photos, downloads and documents, DuoBackup needs access to all files in shared storage.</string>
  <string name="onboarding_storage_limit">Android does not let any app read Android/data or Android/obb, even with this access. Those folders are never backed up.</string>
  <string name="onboarding_storage_grant">Allow access to all files</string>
  <string name="onboarding_storage_granted">Access to files is allowed</string>
  <string name="onboarding_notifications_title">Notifications</string>
