<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied to cloud backup or to another device: the catalog, settings and keys are
     tied to this install and its Keystore key. A new phone connects to the existing backup. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
